% ---------- Expected counts helpers ----------
\providecommand{\RepoRoot}{.}
\ExplSyntaxOn
\prop_new:N \g_abet_expected_counts_prop
\prop_new:N \g_abet_pdf_layout_prop
\bool_new:N \l__abet_section_should_show_bool
\tl_new:N \l__abet_tmp_tl
\tl_new:N \l__abet_tmp_path_tl
\cs_new_protected:Npn \abet_expected_counts_put:nnn #1#2#3
  { \prop_gput:Nnn \g_abet_expected_counts_prop {#1/#2} {#3} }
\cs_new_protected:Npn \abet_expected_counts_if_show:nnn #1#2#3
  {
    \bool_set_false:N \l__abet_section_should_show_bool
    \prop_if_in:NnTF \g_abet_expected_counts_prop {#1/#2}
      {
        \int_compare:nNnTF { \prop_item:Nn \g_abet_expected_counts_prop {#1/#2} } > {0}
          {\bool_set_true:N \l__abet_section_should_show_bool}
          {\abet_section_has_files:nn {#1}{#2}}
      }
      {\abet_section_has_files:nn {#1}{#2}}
    \bool_if:NT \l__abet_section_should_show_bool {#3}
  }
\cs_new_protected:Npn \abet_section_has_files:nn #1#2
  {
    \str_case:nnF {#1}
      {
        {10-lectures}{\abet_lectures_has_files:n {#2}}
        {20-assignments}{\abet_assignments_has_files:n {#2}}
      }
      {\bool_set_true:N \l__abet_section_should_show_bool}
  }
\cs_new_protected:Npn \abet_lectures_has_files:n #1
  {
    \int_step_inline:nn {20}
      {
        \tl_set:Nx \l__abet_tmp_tl { \padtwo{##1} }
        \abet_check_path:n { \CourseRoot/10-lectures/week\l__abet_tmp_tl-part01.pdf }
        \abet_check_path:n { \CourseRoot/10-lectures/week\l__abet_tmp_tl.pdf }
      }
  }
\cs_new_protected:Npn \abet_assignments_has_files:n #1
  {
    \abet_check_path:n { \CourseRoot/20-assignments/asg-all-scores.pdf }
    \abet_check_path:n { \CourseRoot/20-assignments/asg-all-scoresheet.pdf }
    \int_step_inline:nn {30}
      {
        \tl_set:Nx \l__abet_tmp_tl { \padtwo{##1} }
        \abet_check_path:n { \CourseRoot/20-assignments/asg\l__abet_tmp_tl-instructions.pdf }
        \abet_check_path:n { \CourseRoot/20-assignments/asg\l__abet_tmp_tl-high.pdf }
        \abet_check_path:n { \CourseRoot/20-assignments/asg\l__abet_tmp_tl-average.pdf }
        \abet_check_path:n { \CourseRoot/20-assignments/asg\l__abet_tmp_tl-low.pdf }
        \abet_check_path:n { \CourseRoot/20-assignments/asg\l__abet_tmp_tl-scores.pdf }
      }
  }
\cs_new_protected:Npn \abet_check_path:n #1
  {
    \tl_set:Nx \l__abet_tmp_path_tl {#1}
    \IfFileExists{\tl_use:N \l__abet_tmp_path_tl}
      {\bool_set_true:N \l__abet_section_should_show_bool}{}
  }
\NewDocumentCommand{\AddExpectedCount}{ m m m }
  { \abet_expected_counts_put:nnn {#1}{#2}{#3} }
\NewDocumentCommand{\IfExpectedSection}{ m m +m }
  { \abet_expected_counts_if_show:nnn {#1}{#2}{#3} }
\NewDocumentCommand{\AddPdfLayoutOverride}{ m m }
  { \prop_gput:Nnn \g_abet_pdf_layout_prop {#1} {#2} }
\cs_new:Npn \abet_pdf_layout_options:nn #1#2
  {
    \prop_if_in:NnTF \g_abet_pdf_layout_prop {#1}
      { \prop_item:Nn \g_abet_pdf_layout_prop {#1} }
      {#2}
  }
\NewDocumentCommand{\PdfLayoutOptions}{ m m }
  { \abet_pdf_layout_options:nn {#1} {#2} }
\cs_new_protected:Npn \abet_includepdf_with_options:nn #1#2
  { \includepdf[#1]{#2} }
\cs_new_protected:Npn \abet_include_with_layout_if_exists:nn #1#2
  {
    \tl_set:Nx \l__abet_tmp_path_tl {#1}
    \IfFileExists{\tl_use:N \l__abet_tmp_path_tl}
      {
        \tl_set:Nn \l__abet_tmp_tl {#2}
        \prop_get:NVNT \g_abet_pdf_layout_prop \l__abet_tmp_path_tl \l__abet_tmp_tl {}
        \use:x
          {
            \exp_not:N \abet_includepdf_with_options:nn
            { \exp_not:V \l__abet_tmp_tl }
            { \exp_not:V \l__abet_tmp_path_tl }
          }
      }
      {}
  }
\cs_new_eq:NN \AbetIncludeWithLayoutIfExists \abet_include_with_layout_if_exists:nn
\cs_new_protected:Npn \abet_expected_counts_load:
  {
    \IfFileExists{\RepoRoot/config/expected_counts.tex}
      {\input{\RepoRoot/config/expected_counts.tex}}{\IfFileExists{\RepoRoot/../config/expected_counts.tex}{\input{\RepoRoot/../config/expected_counts.tex}}{}}
    \IfFileExists{\RepoRoot/config/pdf_layout_overrides.tex}
      {\input{\RepoRoot/config/pdf_layout_overrides.tex}}{\IfFileExists{\RepoRoot/../config/pdf_layout_overrides.tex}{\input{\RepoRoot/../config/pdf_layout_overrides.tex}}{}}
  }
\AtBeginDocument{\abet_expected_counts_load:}
\ExplSyntaxOff

