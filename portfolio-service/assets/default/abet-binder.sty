% Exams
\NewDocumentCommand{\IfExamHasContent}{ m +m }{%
  \begingroup
  \newif\ifexamcontent
  \examcontentfalse
  \IfFileExists{\CourseRoot/40-exams/#1-scores.pdf}{\examcontenttrue}{}%
  \IfFileExists{\CourseRoot/40-exams/#1-instructions.pdf}{\examcontenttrue}{}%
  \IfFileExists{\CourseRoot/40-exams/#1-high.pdf}{\examcontenttrue}{}%
  \IfFileExists{\CourseRoot/40-exams/#1-average.pdf}{\examcontenttrue}{}%
  \IfFileExists{\CourseRoot/40-exams/#1-low.pdf}{\examcontenttrue}{}%
  \ifexamcontent
    \endgroup #2%
  \else
    \endgroup
  \fi
}
\newcommand{\ExamBlock}[2]{% #1 label, #2 basename (midterm/final)
  \IfFileExists{\CourseRoot/40-exams/#2-scores.pdf}{%
    \SubHeaderPage{#1\ Scoresheet}\ExamInclude{\CourseRoot/40-exams/#2-scores.pdf}}{}%
  \IfFileExists{\CourseRoot/40-exams/#2-instructions.pdf}{%
    \SubHeaderPage{#1\ Instructions}\ExamInclude{\CourseRoot/40-exams/#2-instructions.pdf}}{}%
  \IfFileExists{\CourseRoot/40-exams/#2-high.pdf}{%
    \SubHeaderPage{#1\ High Sample}\ExamInclude{\CourseRoot/40-exams/#2-high.pdf}}{}%
  \IfFileExists{\CourseRoot/40-exams/#2-average.pdf}{%
    \SubHeaderPage{#1\ Average Sample}\ExamInclude{\CourseRoot/40-exams/#2-average.pdf}}{}%
  \IfFileExists{\CourseRoot/40-exams/#2-low.pdf}{%
    \SubHeaderPage{#1\ Low Sample}\ExamInclude{\CourseRoot/40-exams/#2-low.pdf}}{}%
}
