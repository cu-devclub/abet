% ---------- Running header/foot layout ----------
\fancyhf{} % clear
\fancyhead[C]{\textbf{\leftmark}\ifx\rightmark\empty\else\ /\ \rightmark\fi}
% These commands are expected from course-meta.tex; provide safe fallbacks
\providecommand{\CourseName}{Course Name}
\providecommand{\CourseCode}{CODE}
\providecommand{\CourseInstructorsShort}{Instructor(s)}
\fancyfoot[L]{\CourseName\ (\CourseCode)\quad|\quad \CourseInstructorsShort}
\fancyfoot[R]{Page \thepage\ of \pageref{LastPage}}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.4pt}
\newcommand{\SetHeaderMarks}[2]{\markboth{#1}{#2}}

% ---------- Cover: full-bleed image + movable title block ----------
% \CourseCoverWithImage[<y>][<x>][<width fraction>]{<file>}
\NewDocumentCommand{\CourseCoverWithImage}{ O{0cm} O{0cm} O{.78} m }{%
  \clearpage
  \thispagestyle{empty}
  \AddToShipoutPictureBG*{%
    \AtPageLowerLeft{\includegraphics[page=1,width=\paperwidth,height=\paperheight]{#4}}%
  }
  \begin{tikzpicture}[remember picture,overlay]
    \node[inner xsep=0pt, inner ysep=0pt, text width=#3\paperwidth, align=center]
      at ($ (current page.center) + (#2,#1) $) {%
        {\fontsize{48}{56}\selectfont\bfseries\color{black}\CourseCode\par}
        \vspace{0.5em}
        {\fontsize{36}{44}\selectfont\bfseries\color{black}\CourseName\par}
        \ifcsname SemesterLabel\endcsname
          \vspace{0.4em}{\Large\color{black}\SemesterLabel\par}
        \fi
      };
  \end{tikzpicture}
  \clearpage
  \ClearShipoutPictureBG
}

% ---------- Header-page macros that write to ToC ----------
\newcolumntype{L}[1]{>{\RaggedRight\arraybackslash}p{#1}}
\newcolumntype{V}{>{\RaggedRight\arraybackslash}X}

\newcommand{\BigHeaderPage}[2][]{%
  \clearpage\phantomsection\addcontentsline{toc}{section}{#2}%
  \SetHeaderMarks{#2}{}%
  \thispagestyle{fancy}
  \begin{center}\vspace*{0.28\textheight}
    {\fontsize{36}{44}\selectfont\bfseries #2\par}
    \if\relax\detokenize{#1}\relax\else\vspace{0.75em}{\Large #1\par}\fi
    \vfill
  \end{center}
}
\newcommand{\SubHeaderPage}[2][]{%
  \clearpage\phantomsection\addcontentsline{toc}{subsection}{#2}%
  \markright{#2}\thispagestyle{fancy}
  \begin{center}\vspace*{0.30\textheight}
    {\Large\bfseries #2\par}
    \if\relax\detokenize{#1}\relax\else\vspace{0.6em}{\large #1\par}\fi
    \vfill
  \end{center}
}
\newcommand{\SubSubHeaderPage}[2][]{%
  \clearpage\phantomsection\addcontentsline{toc}{subsubsection}{#2}%
  \markright{#2}\thispagestyle{fancy}
  \begin{center}\vspace*{0.32\textheight}
    {\large\bfseries #2\par}
    \if\relax\detokenize{#1}\relax\else\vspace{0.5em}{\normalsize #1\par}\fi
    \vfill
  \end{center}
}
% Silent version: writes ToC + header marks, but no visible heading
\newcommand{\SubHeaderPageSilent}[1]{%
  \clearpage
  \phantomsection
  \addcontentsline{toc}{subsection}{#1}%
  \markright{#1}%
  \thispagestyle{fancy}%
}
% Label + indented block (no bullets) — fixed
\newcommand{\FieldBlock}[2]{%
  \par\medskip
  \noindent\textbf{#1:}\par
  \begingroup
    \leftskip=1.5em
    \parindent=0pt   % <-- make all lines align
    #2\par
  \endgroup
}
% Label + indented enumerated block with tight spacing (matches FieldBlock)
\newcommand{\FieldEnumBlock}[2]{%
  \par\medskip
  \noindent\textbf{#1:}\par
  \begingroup
    \leftskip=1.5em
    \parindent=0pt
    \begin{enumerate}[itemsep=0pt, topsep=0pt, parsep=0pt, partopsep=0pt]
      #2
    \end{enumerate}
  \endgroup
}

% ---------- Include helpers ----------
\newcommand{\IncludeIfExists}[2]{%
  \IfFileExists{#1}{\includepdf[#2]{#1}}{}%
}
\NewDocumentCommand{\IncludeWithLayoutIfExists}{ m m }
  { \AbetIncludeWithLayoutIfExists{#1}{#2} }


% Textbook include with fast/slow behavior
% \TextbookInclude{<file>}[<pages>][<scale>]
\NewDocumentCommand{\TextbookInclude}{ m O{-} O{0.85} }{%
  \IfFileExists{#1}{%
    \iffastcompile
      \IncludeWithLayoutIfExists{#1}{pages=1,pagecommand={\thispagestyle{fancy}},scale=0.75}%
    \else
      \IncludeWithLayoutIfExists{#1}{pages=#2,pagecommand={\thispagestyle{fancy}},scale=#3}%
    \fi
  }{}%
}

% Exam include with fast/slow behavior
\newcommand{\ExamInclude}[1]{%
  \iffastcompile
    \IncludeWithLayoutIfExists{#1}{pages=1,pagecommand={\thispagestyle{fancy}},scale=0.9}%
  \else
    \IncludeWithLayoutIfExists{#1}{pages=-,pagecommand={\thispagestyle{fancy}}}%
  \fi
}

% ---------- AUTO BLOCKS ----------
% Textbook: tries textbook-part01..99
\newcommand{\TextbookBlock}[1]{% #1 = folder path like \CourseRoot/02-textbook
  \foreach \n in {1,...,99}{%
    \edef\pp{\padtwo{\n}}%
    \edef\thisfile{#1/textbook-part\pp.pdf}%
    \TextbookInclude{\thisfile}%
  }%
}

% Lectures: include weekNN-part01..09 (4-up in final, first page in fast)
\newcommand{\LectureWeekBlock}[1]{% #1 numeric 1..20
  \begingroup
    \edef\wk{\padtwo{#1}}%
    \IfFileExists{\CourseRoot/10-lectures/week\wk-part01.pdf}{%
      \SubHeaderPage{Lecture Slides Week \number\numexpr#1\relax}%
      \foreach \p in {1,...,9}{%
        \edef\pp{\padtwo{\p}}%
        \iffastcompile
          \IncludeWithLayoutIfExists{\CourseRoot/10-lectures/week\wk-part\pp.pdf}{pages=1,landscape=true,frame=true,pagecommand={\thispagestyle{fancy}},scale=0.75}%
        \else
          \IncludeWithLayoutIfExists{\CourseRoot/10-lectures/week\wk-part\pp.pdf}{pages=-,nup=2x2,landscape=true,frame=true,pagecommand={\thispagestyle{fancy}},scale=0.85}%
        \fi
      }%
    }{}%
  \endgroup
}


% Assignments: show the block if ANY file exists; include pieces conditionally
\newcommand{\AssignmentBlock}[1]{% #1 = numeric 1..30
  \begingroup
    \edef\anum{\number\numexpr#1\relax}
    \edef\aXX{\padtwo{\anum}}

    % ---- probe for any file ----
    \asghavefalse
    \IfFileExists{\CourseRoot/20-assignments/asg\aXX-instructions.pdf}{\asghavetrue}{}%
    \IfFileExists{\CourseRoot/20-assignments/asg\aXX-high.pdf}{\asghavetrue}{}%
    \IfFileExists{\CourseRoot/20-assignments/asg\aXX-average.pdf}{\asghavetrue}{}%
    \IfFileExists{\CourseRoot/20-assignments/asg\aXX-low.pdf}{\asghavetrue}{}%
    \IfFileExists{\CourseRoot/20-assignments/asg\aXX-scores.pdf}{\asghavetrue}{}%

    \ifasghave
      \SubHeaderPage{Assignment \anum}%

      % ---- Instructions (optional) ----
      \IfFileExists{\CourseRoot/20-assignments/asg\aXX-instructions.pdf}{%
        \SubSubHeaderPage{Assignment \anum\ Instructions}%
        \iffastcompile
          \IncludeWithLayoutIfExists{\CourseRoot/20-assignments/asg\aXX-instructions.pdf}{pages=1,pagecommand={\thispagestyle{fancy}},scale=0.9}%
        \else
          \IncludeWithLayoutIfExists{\CourseRoot/20-assignments/asg\aXX-instructions.pdf}{pages=-,pagecommand={\thispagestyle{fancy}}}%
        \fi
      }{}%

      % ---- High (optional) ----
      \IfFileExists{\CourseRoot/20-assignments/asg\aXX-high.pdf}{%
        \SubSubHeaderPage{Assignment \anum\ High Sample}%
        \iffastcompile
          \IncludeWithLayoutIfExists{\CourseRoot/20-assignments/asg\aXX-high.pdf}{pages=1,pagecommand={\thispagestyle{fancy}},scale=0.9}%
        \else
          \IncludeWithLayoutIfExists{\CourseRoot/20-assignments/asg\aXX-high.pdf}{pages=-,pagecommand={\thispagestyle{fancy}}}%
        \fi
      }{}%

      % ---- Average (optional) ----
      \IfFileExists{\CourseRoot/20-assignments/asg\aXX-average.pdf}{%
        \SubSubHeaderPage{Assignment \anum\ Average Sample}%
        \iffastcompile
          \IncludeWithLayoutIfExists{\CourseRoot/20-assignments/asg\aXX-average.pdf}{pages=1,pagecommand={\thispagestyle{fancy}},scale=0.9}%
        \else
          \IncludeWithLayoutIfExists{\CourseRoot/20-assignments/asg\aXX-average.pdf}{pages=-,pagecommand={\thispagestyle{fancy}}}%
        \fi
      }{}%

      % ---- Low (optional) ----
      \IfFileExists{\CourseRoot/20-assignments/asg\aXX-low.pdf}{%
        \SubSubHeaderPage{Assignment \anum\ Low Sample}%
        \iffastcompile
          \IncludeWithLayoutIfExists{\CourseRoot/20-assignments/asg\aXX-low.pdf}{pages=1,pagecommand={\thispagestyle{fancy}},scale=0.9}%
        \else
          \IncludeWithLayoutIfExists{\CourseRoot/20-assignments/asg\aXX-low.pdf}{pages=-,pagecommand={\thispagestyle{fancy}}}%
        \fi
      }{}%

      % ---- Scores (optional) ----
      \IfFileExists{\CourseRoot/20-assignments/asg\aXX-scores.pdf}{%
        \iffastcompile
          \IncludeWithLayoutIfExists{\CourseRoot/20-assignments/asg\aXX-scores.pdf}{pages=1,pagecommand={\thispagestyle{fancy}},scale=0.9}%
        \else
          \IncludeWithLayoutIfExists{\CourseRoot/20-assignments/asg\aXX-scores.pdf}{pages=-,pagecommand={\thispagestyle{fancy}}}%
        \fi
      }{}%

    \fi
  \endgroup
}

