% ---------- Utilities ----------
\newcommand{\Probe}[1]{\typeout{[BINDER] probing: #1}}
\newcommand{\padtwo}[1]{\ifnum#1<10 0#1\else #1\fi}

\providecommand{\LectureIncludeOptsFast}{pages=1,landscape=true,frame=true,pagecommand={\thispagestyle{fancy}},scale=0.75}
\providecommand{\LectureIncludeOptsFinal}{pages=-,nup=2x2,landscape=true,frame=true,pagecommand={\thispagestyle{fancy}},scale=0.85}

% -- ABET syllabus include (prefer rendered .tex; fallback to the original PDF)
\newcommand{\IncludeABETFromData}{%
  \IfFileExists{\CourseRoot/01-syllabus/syllabus-abet.tex}{%
    \input{\CourseRoot/01-syllabus/syllabus-abet.tex}%
  }{%
    \IncludeWithLayoutIfExists{\CourseRoot/01-syllabus/syllabus-abet.pdf}{pages=-,pagecommand={\thispagestyle{fancy}}}%
  }%
