# RabbitMQ Configuration
RABBITMQ_HOST=abet-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=course_build_queue
RABBITMQ_STATUS_QUEUE=course_status_queue

# Worker Configuration
DEFAULT_OUTPUT_DIR=C:\var\storage\output_pdfs
DELETE_ZIP_DEFAULT=true
LOG_LEVEL=INFO

# MinIO (payload v2 "storage": "s3"; read directly from the environment)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=abet-app
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=abet
MINIO_USE_SSL=false
