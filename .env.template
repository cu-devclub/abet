# ABET Course Portfolio System - environment template.
# Copy to .env (`make env`) and replace every `change-me`. Never commit .env.

# Compose project name (prefix for containers/volumes)
COMPOSE_PROJECT_NAME=abet

# ---- Gateway / URLs ----
# Host port the API gateway publishes (the only port published in prod)
GATEWAY_HTTP_PORT=8000
# Browser-facing origin; used for the OAuth redirect and post-login redirect
PUBLIC_BASE_URL=http://localhost:8000

# ---- Postgres ----
# Superuser/owner for auth_db and main_db
POSTGRES_USER=abet
# Postgres password (use a long random value)
POSTGRES_PASSWORD=change-me
# Postgres hostname inside the compose network
POSTGRES_HOST=postgres
# Postgres port inside the compose network
POSTGRES_PORT=5432
# Database owned by auth-service (sessions)
AUTH_DB_NAME=auth_db
# Database owned by main-service (domain data)
MAIN_DB_NAME=main_db
# Dev only: port on the host where Postgres is published
POSTGRES_HOST_PORT=5432

# ---- RabbitMQ ----
# RabbitMQ hostname inside the compose network
RABBITMQ_HOST=rabbitmq
# AMQP port inside the compose network
RABBITMQ_PORT=5672
# RabbitMQ user (also the management UI login)
RABBITMQ_USER=abet
# RabbitMQ password (use a long random value)
RABBITMQ_PASS=change-me
# RabbitMQ virtual host
RABBITMQ_VHOST=/
# Queue main-service publishes build jobs to
RABBITMQ_QUEUE=course_build_queue
# Queue portfolio-service publishes job results to
RABBITMQ_STATUS_QUEUE=course_status_queue
# Dev only: port on the host where the RabbitMQ management UI is published
RABBITMQ_MGMT_HOST_PORT=15672

# ---- Google OAuth ----
# OAuth client id from Google Cloud Console (empty = Google login returns 503)
GOOGLE_CLIENT_ID=
# OAuth client secret from Google Cloud Console
GOOGLE_CLIENT_SECRET=
# Must equal an Authorized redirect URI of the OAuth client
GOOGLE_REDIRECT_URL=http://localhost:8000/public/api/v1/auth/google/callback
# Comma-separated allowed email domains (exact match, case-insensitive)
ALLOWED_EMAIL_DOMAINS=chula.ac.th

# ---- Sessions ----
# HMAC key (>= 32 chars) for session JWTs and the OAuth state cookie
SESSION_SECRET=change-me-to-64-random-chars
# Session lifetime in hours
SESSION_TTL_HOURS=12
# Set true when served over HTTPS (production)
COOKIE_SECURE=false

# ---- Service-to-service ----
# Shared token for auth-service -> main-service /internal/* calls
INTERNAL_API_TOKEN=change-me

# ---- Bootstrap ----
# Comma-separated emails upserted as super_admin on main-service startup
SUPER_ADMIN_EMAILS=

# ---- Files ----
# All files live in MinIO (S3). Console login = MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
MINIO_ROOT_USER=abetminio
# MinIO root password (>= 12 chars; double-quote it if it contains special characters)
MINIO_ROOT_PASSWORD=change-me-minio-root
# S3 endpoint inside the compose network (never published)
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
MINIO_BUCKET=abet
# Service account used by main-service and portfolio-service (policy limited to MINIO_BUCKET, created by minio-init)
MINIO_ACCESS_KEY=abet-app
# Service account secret (8-40 chars)
MINIO_SECRET_KEY=change-me-minio-svc
# Host port of the MinIO console (published in dev and prod)
MINIO_CONSOLE_HOST_PORT=9001
# Dev only: host port of the S3 API (debugging)
# MINIO_API_HOST_PORT=9000
# Max upload size per portfolio zip, in MB
MAX_UPLOAD_MB=300
# Max curriculum cover PDF size, in MB
MAX_COVER_MB=20
# Max course-instructor mapping CSV import size, in MB
# MAX_IMPORT_MB=5
# Gateway body limit is derived automatically: max(MAX_UPLOAD_MB, MAX_COVER_MB, MAX_IMPORT_MB) + 20 MB

# ---- Portfolio worker ----
# Minutes a submission may stay "Processing" before it is marked failed (BUILD_TIMEOUT)
# BUILD_TIMEOUT_MINUTES=60
# Seconds between timeout-reconciler / queue-health / janitor ticks in main-service
# RECONCILE_INTERVAL_SECONDS=60
# Number of parallel portfolio-service worker containers
# PORTFOLIO_WORKER_REPLICAS=2
# Delete the uploaded zip after a successful build
DELETE_ZIP_DEFAULT=true
# Log level for all services (Go services lower-case it)
LOG_LEVEL=INFO

# ---- Monitoring (optional; compose profile "monitoring") ----
# false = no monitoring container runs. `make dev MON=1` / `make prod MON=1` switch it on for one run.
# Grafana (metrics) is served at <PUBLIC_BASE_URL>/grafana/ and Kibana (logs + traces) at <PUBLIC_BASE_URL>/kibana/,
# both only through the gateway. See `make mon-urls`.
MONITORING_ENABLED=false
# Kibana login user is "elastic". Passwords may contain special characters: keep them double-quoted, avoid $ \ and ".
ELASTIC_PASSWORD="change-me-elastic"
KIBANA_SYSTEM_PASSWORD=change-me-kibana-system
ES_INGEST_PASSWORD=change-me-es-ingest
ES_READER_PASSWORD=change-me-es-reader
# At least 32 characters
KIBANA_ENCRYPTION_KEY=change-me-at-least-32-characters-long-key
# Bearer token of APM Server (services + gateway send traces with it)
APM_SECRET_TOKEN=change-me-apm-secret-token
# Elasticsearch JVM heap in MB
ES_HEAP_MB=1024
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD="change-me-grafana"
# Password of the read-only Postgres role abet_monitor used by postgres-exporter
POSTGRES_MONITOR_PASSWORD=change-me-pg-monitor
# How long Prometheus keeps metrics (logs and traces in Elasticsearch are kept until `make mon-prune`)
PROMETHEUS_RETENTION=15d
# Share of requests that are traced (0..1)
OTEL_SAMPLE_RATIO=1.0
# DEV only: Prometheus UI on this host port
PROMETHEUS_HOST_PORT=9090
