            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(container_last_seen{env=~\"$env\",container_label_com_docker_compose_service=~\"$service\"})",
          "legendFormat": "",
          "range": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
